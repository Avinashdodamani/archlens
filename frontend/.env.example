# ArchLens Dashboard Configuration
# Copy this file as .env and fill in your values

# AWS Cognito Configuration
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_app_client_id_here
VITE_COGNITO_DOMAIN=your-domain.auth.ap-south-1.amazoncognito.com

# API Gateway Configuration
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/dev

# AWS Region
VITE_AWS_REGION=ap-south-1

# S3 Buckets (for presigned URL generation references)
VITE_DATA_BUCKET=archlens-data-YOUR_ACCOUNT_ID

# Application Settings
VITE_APP_NAME=ArchLens
VITE_APP_VERSION=1.0.0
